import { SkiaPictureView, type SkPicture } from '@shopify/react-native-skia';
import { useEffect, useRef } from 'react';
import { StyleSheet, useWindowDimensions } from 'react-native';

import { SkiaBenchmarkRenderer, createBenchmarkPicture } from './lib/skiaBenchmark';

type SkiaViewApiLike = {
  setJsiProperty: (nativeId: number, name: string, value: unknown) => void;
};

const setPicture = (nativeId: number, picture: SkPicture) => {
  const api = (globalThis as { SkiaViewApi?: SkiaViewApiLike }).SkiaViewApi;
  if (!api) {
    throw new Error('SkiaViewApi was not found.');
  }
  api.setJsiProperty(nativeId, 'picture', picture);
};

export default function HomeScreen() {
  const { width, height } = useWindowDimensions();
  const rendererRef = useRef<SkiaBenchmarkRenderer | null>(null);
  const viewRef = useRef<SkiaPictureView | null>(null);
  const initialPictureRef = useRef<SkPicture | null>(null);
  const currentPictureRef = useRef<SkPicture | null>(null);

  if (!rendererRef.current) {
    rendererRef.current = new SkiaBenchmarkRenderer();
  }

  if (!initialPictureRef.current) {
    initialPictureRef.current = createBenchmarkPicture(width, height, 1, 0);
    currentPictureRef.current = initialPictureRef.current;
  }

  useEffect(() => {
    let active = true;
    let frameId = 0;

    const render = (now: number) => {
      if (!active) {
        return;
      }

      const view = viewRef.current;
      const renderer = rendererRef.current;
      if (view && renderer) {
        const picture = renderer.render({ width, height }, now);
        setPicture(view.nativeId, picture);
        view.redraw();
        if (currentPictureRef.current && currentPictureRef.current !== picture) {
          currentPictureRef.current.dispose?.();
        }
        currentPictureRef.current = picture;
      }

      frameId = requestAnimationFrame(render);
    };

    frameId = requestAnimationFrame(render);

    return () => {
      active = false;
      cancelAnimationFrame(frameId);
    };
  }, [height, width]);

  useEffect(() => {
    return () => {
      rendererRef.current?.dispose();
      rendererRef.current = null;
      currentPictureRef.current?.dispose?.();
      currentPictureRef.current = null;
      initialPictureRef.current = null;
    };
  }, []);

  return (
    <SkiaPictureView
      ref={viewRef}
      picture={initialPictureRef.current ?? undefined}
      style={styles.canvas}
      collapsable={false}
    />
  );
}

const styles = StyleSheet.create({
  canvas: {
    flex: 1,
  },
});
